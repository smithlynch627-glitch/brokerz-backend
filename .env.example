# ============================================================
# Brokerz backend — Robinhood Chain mainnet
# Save as: backend/.env       (never commit this file)
# ============================================================

RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
EXPLORER_URL=https://robinhoodchain.blockscout.com

# Optional extra endpoints for failover. Comma-separated, no spaces.
FALLBACK_RPC_URLS=

# Multicall3 at its canonical cross-chain address. If Robinhood Chain has no
# deployment there, blank this out — the client falls back to plain JSON-RPC
# batching, which needs no helper contract.
MULTICALL3_ADDRESS=0xcA11bde05977b3631167028862bE2a173976CA11

# --- deployed contracts ---
BRKZ_ADDRESS=0x55aFa004a3114B6109c8b68347ce3Bdd7d6aa3Ae
BRKZ_SALE_ADDRESS=0x6260792854BBf6a94362a5c39F6507e31BbcAd1C
BROKERZ_HOMES_ADDRESS=0xe4768D681523178d9CCdAa8bBc384350B80B1145

# Block the BRKZ deploy landed in. The event indexer scans forward from here
# rather than from genesis.
DEPLOY_BLOCK=47295240

# --- CORS: only these origins may call the API ---
ALLOWED_ORIGINS=https://brokerz.homes,https://www.brokerz.homes

PORT=3001

# --- cache lifetimes (ms) ---
STATS_REFRESH_MS=20000
POLL_INTERVAL_MS=20000
WALLET_CACHE_MS=300000

# --- Supabase: fill these in ---
# Dashboard -> Project Settings -> API
# Use the service_role key, NOT anon. It bypasses RLS entirely, so treat it
# like a private key: server-side only, never in the frontend.
# Rate limits, per IP. Raise if legitimate users are being throttled —
# mobile carriers share one address across many people, so a limit sized for
# an individual can block an entire network.
#
# Set any to 0 to disable that limiter.
# Leaving RATE_LIMIT_REDEEM enabled is strongly advised: codes are reusable,
# so one guessed code grants lasting access to whoever it is shared with.
RATE_LIMIT_API=2000
RATE_LIMIT_STREAM=200
RATE_LIMIT_REDEEM=30

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LOCAL DEV ONLY. Overrides the launch phase for every visitor — never set
# this on Railway. Values: coming_soon | code_required | public
# FORCE_PHASE=
